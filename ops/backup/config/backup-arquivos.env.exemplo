# Configuração do backup de arquivos (E2). Somente nomes e exemplos; nunca colocar segredos aqui.
# As fontes e os arquivos de referências vão como argumentos: --fonte <id>=<dir absoluto> e --referencias <id>=<arquivo.ndjson>.

# Diretório de destino (obrigatório): existente, do usuário atual, modo 0700, fora de áreas sincronizadas.
BACKUP_DESTINO=

# Diretório de uma execução íntegra do backup-db.sh (obrigatório): o banco vem antes dos arquivos (errata E-65-01).
BACKUP_DB_EXEC=

# Idade máxima, em segundos, do backup de banco usado como base (opcional; padrão 3600).
BACKUP_DB_IDADE_MAX_S=

# Tentativas de cópia por execução, de 1 a 3 (opcional; padrão 3).
BACKUP_TENTATIVAS=

# Limite de bytes copiados somando as tentativas (opcional; padrão 21474836480 = 20 GiB).
BACKUP_LIMITE_BYTES=
