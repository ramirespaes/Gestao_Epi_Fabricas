# Configuração do backup (E1). Somente nomes e exemplos não sensíveis; nunca colocar senhas aqui.
# A autenticação do PostgreSQL vem de PGPASSFILE (arquivo 0600 fora do repositório) ou de PGPASSWORD no ambiente do agendador.

# Nome do banco de origem (obrigatório). Aceita [A-Za-z0-9_.-], até 63 caracteres, sem começar por hífen.
BACKUP_DB_NOME=

# Diretório de destino (obrigatório): deve existir, ser do usuário atual, ter modo 0700
# e ficar fora de áreas sincronizadas (Desktop, Documents, iCloud, Dropbox, OneDrive, Google Drive).
BACKUP_DESTINO=

# Diretório com pg_dump e pg_restore 16 (opcional; padrão: o pg_dump do PATH).
BACKUP_PG_BIN=

# Raiz do repositório da aplicação, para registrar a última migration no manifesto (opcional).
BACKUP_REPO_RAIZ=

# Aceita dump sem nenhum objeto de usuário (1). Padrão: recusa (código 6), porque backup vazio costuma indicar erro.
# Use só para bancos de teste vazios; a execução registra o aviso e o manifesto mostra toc.entradas = 0.
BACKUP_PERMITIR_BANCO_VAZIO=

# Conexão (opcionais; padrões do cliente PostgreSQL): PGHOST, PGPORT, PGUSER, PGPASSFILE
