# MODELO da origem do Portal do Cliente (homologacao). Nao aplicado em nenhum servidor.
# O conteudo vem do link de release mantido pelo instalador; a API do cliente fica em /api/.
server {
    listen 80;
    server_name {{DOMINIO_PORTAL}};
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root {{RAIZ_ACME}};
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://{{DOMINIO_PORTAL}}$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name {{DOMINIO_PORTAL}};
    server_tokens off;

    ssl_certificate {{CERTIFICADO_PORTAL}};
    ssl_certificate_key {{CHAVE_PORTAL}};
    ssl_protocols TLSv1.2 TLSv1.3;

    root {{RAIZ_PORTAL}};
    autoindex off;
    client_max_body_size {{LIMITE_CORPO}};

    include {{ARQUIVO_SEGURANCA_PORTAL}};

    location ~ /\. {
        return 404;
    }

    location = /versao.json {
        allow 127.0.0.1;
        allow ::1;
        allow {{REDE_VERIFICACAO}};
        deny all;
        alias {{ARQUIVO_VERSAO_PORTAL}};
        default_type application/json;
        include {{ARQUIVO_SEGURANCA_PORTAL}};
        add_header Cache-Control "no-store" always;
    }

    location ^~ /api/plataforma/ {
        return 404;
    }

    location ^~ /api/ {
        # O prefixo acima é sensível a caixa e exige a barra final; aqui o namespace da plataforma é negado em qualquer
        # caixa, com ou sem barra, sobre a URI já normalizada pelo Nginx ($uri).
        if ($uri ~* "^/api/plataforma(/|$)") {
            return 404;
        }
        proxy_pass http://127.0.0.1:{{PORTA_BACKEND}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header X-Powered-By;
        proxy_read_timeout 60s;
    }

    location = / {
        return 302 {{DESTINO_RAIZ_PORTAL}};
    }

    # Previa do Totem: a pagina de atendimento cria um iframe da mesma origem e so a previa aceita ser enquadrada, e apenas
    # pela mesma origem. Cada location repete o conjunto completo de cabecalhos (arquivos proprios); o resto do site segue em DENY.
    location = /pages/atendimento-token.html {
        include {{ARQUIVO_SEGURANCA_PORTAL_ATENDIMENTO}};
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    location = /totem/previa.html {
        include {{ARQUIVO_SEGURANCA_PORTAL_PREVIA}};
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    location / {
        include {{ARQUIVO_SEGURANCA_PORTAL}};
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/index.html =404;
    }
}
