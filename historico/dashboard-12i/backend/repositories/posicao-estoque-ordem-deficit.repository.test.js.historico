'use strict';

const { describe, test } = require('node:test');
const assert = require('node:assert/strict');
const { exigirModulo } = require('../helpers/exigir-modulo');

/**
 * 12I, Task 01 — ordenação opt-in por maior déficit em `listarPosicoes` (RED),
 * sem PostgreSQL real: só a validação da opção e o caminho padrão. A ordem
 * efetiva (déficit desc, depois lower(nome), material, tamanho) é provada em
 * banco real em `dashboard-previa-abaixo-minimo.integration.js`. A ordenação
 * padrão (nome, material, tamanho) das demais telas NÃO muda.
 */

const repo = () => exigirModulo('src/repositories/posicao-estoque.repository');
const EMPRESA = 42;
const base = (extra = {}) => ({ hoje: '2026-10-02', diasAlerta: 60, pagina: 1, limite: 5, ...extra });

const linha = { total: 1, material_id: 1, nome: 'Luva', tamanho_chave: 'M', unidade: 'par', saldo: '1', bloqueado: '0', fisico_utilizavel: '1', demanda_pendente: '0', comprometido: '0', saldo_livre: '1', sem_cobertura: '0', minimo_efetivo: '5', minimo_origem: 'PADRAO', abaixo_do_minimo: true, deficit: '4', necessidade: '4', ca_validade: null, validade: 'ok' };

function executorFalso() {
  const chamadas = [];
  return { chamadas, query: async (texto, valores) => { chamadas.push({ texto, valores }); return { rows: [linha], rowCount: 1 }; } };
}

describe('listarPosicoes — opção `ordem` (12I, Task 01)', () => {
  test('ordem DEFICIT_DESC é aceita e chega ao banco; a consulta ordena por déficit decrescente antes do nome', async () => {
    const ex = executorFalso();
    await repo().listarPosicoes(ex, EMPRESA, base({ situacao: 'ABAIXO_MINIMO', ordem: 'DEFICIT_DESC' }));
    assert.equal(ex.chamadas.length, 1);
    // Decisão da Task 01: SQL fixo. A opção só escolhe entre dois textos prontos; o valor do chamador nunca entra no SQL
    // nem vira parâmetro, e os parâmetros são os mesmos da consulta padrão.
    assert.match(ex.chamadas[0].texto, /deficit\s+DESC,\s*lower\(nome\),\s*material_id,\s*tamanho_chave/i, 'déficit decrescente e, no empate, a ordem padrão');
    assert.match(ex.chamadas[0].texto, /pagina\.deficit\s+DESC,\s*lower\(pagina\.nome\)/i, 'a saída final repete a mesma ordem');
    assert.equal(ex.chamadas[0].texto.includes('DEFICIT_DESC'), false, 'o valor do chamador não é interpolado no SQL');
    assert.equal(ex.chamadas[0].valores.includes('DEFICIT_DESC'), false, 'e também não é parâmetro: o SQL é fixo');
    const padrao = executorFalso();
    await repo().listarPosicoes(padrao, EMPRESA, base({ situacao: 'ABAIXO_MINIMO' }));
    assert.equal(ex.chamadas[0].valores.length, padrao.chamadas[0].valores.length, 'mesmos parâmetros da consulta padrão');
    assert.notEqual(ex.chamadas[0].texto, padrao.chamadas[0].texto);
    assert.equal(/deficit\s+DESC/i.test(padrao.chamadas[0].texto), false, 'a consulta padrão não ordena por déficit');
  });

  test('sem `ordem` (e com ordem null) o resultado e os parâmetros seguem o padrão: nenhum DEFICIT_DESC vai ao banco', async () => {
    const ex = executorFalso();
    await repo().listarPosicoes(ex, EMPRESA, base());
    await repo().listarPosicoes(ex, EMPRESA, base({ ordem: null }));
    for (const c of ex.chamadas) assert.equal(c.valores.includes('DEFICIT_DESC'), false);
  });

  test('ordem desconhecida é erro de programação, antes de consultar', async () => {
    const ex = executorFalso();
    for (const ruim of ['deficit_desc', 'DEFICIT_ASC', 'nome', '', 5, true, {}]) {
      await assert.rejects(() => repo().listarPosicoes(ex, EMPRESA, base({ ordem: ruim })), (e) => e instanceof TypeError && /ordena/i.test(e.message), String(ruim));
    }
    assert.equal(ex.chamadas.length, 0, 'nada foi consultado');
  });

  test('o fragmento padrão de ordenação (nome, material, tamanho) continua presente na consulta', async () => {
    const ex = executorFalso();
    await repo().listarPosicoes(ex, EMPRESA, base());
    assert.match(ex.chamadas[0].texto, /lower\(nome\),\s*material_id,\s*tamanho_chave/);
  });
});
