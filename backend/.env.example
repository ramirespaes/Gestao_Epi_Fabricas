# Porta em que a API vai escutar
PORT=3000

# Ambiente de execução (development | production | test).
# Em production o cookie de sessão é sempre Secure (ver SESSAO_COOKIE_SECURE).
NODE_ENV=development

# Origem(ns) permitida(s) para CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:5500

# --- Painel Privado da plataforma (Autenticação Global — Pacote 2) ---
# Allowlist SEPARADA de CORS_ORIGIN, exclusiva das rotas /api/plataforma.
# Nunca compartilhar origem com CORS_ORIGIN: um script rodando na origem do
# cliente nunca pode ser uma origem aceita para o Painel Privado, e vice-versa.
# O processo RECUSA A INICIALIZAR se qualquer origem aparecer nas duas
# listas ao mesmo tempo (correção final do Pacote 2, item 2 — isolamento
# de origens verificado na subida, não só documentado). Mesmas regras de
# formato de CORS_ORIGIN (canônica, sem curinga, https em production).
# Padrão fora de production: http://localhost:5501.
PLATAFORMA_CORS_ORIGIN=http://localhost:5501

# Host esperado nas requisições de /api/plataforma (defesa em profundidade).
# OBRIGATÓRIO em production (correção final do Pacote 2, item 3): a ausência
# impede a inicialização do processo, para que a validação de Host nunca
# fique sem efeito em produção por uma variável esquecida. Em development e
# test continua opcional — vazio/ausente: nenhuma validação de Host é
# aplicada (sem subdomínio próprio ainda nesses ambientes). Em produção,
# defina o subdomínio real do Painel Privado (ex.: admin.dominio.com.br).
PLATAFORMA_HOST=

# Conexão com o PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestao_epi
DB_USER=postgres
DB_PASSWORD=postgres

# ------------------------------------------------------------------
# Autenticação (lida e validada por src/config/auth.js na subida do processo)
# Variável vazia conta como ausente e usa o padrão indicado. Se qualquer
# valor for inválido, o processo não sobe e o erro cita só o nome da variável.
# ------------------------------------------------------------------

# Segredo do HMAC-SHA-256 que deriva login_tentativas.chave_cooldown.
# OBRIGATÓRIO, sem padrão e sem fallback em nenhum ambiente.
# Formato: hexadecimal, comprimento par, mínimo 64 caracteres (32 bytes).
# Gere localmente e cole o resultado no seu .env (nunca aqui):
#   openssl rand -hex 32
# O valor gerado NÃO deve ser commitado. Em produção, use um gestor de
# secrets. Trocar o segredo zera, na prática, todos os cooldowns em curso.
LOGIN_COOLDOWN_HMAC_SECRET=

# --- Cookie de sessão (HttpOnly sempre; a emissão fica no módulo de sessão) ---
# Nome do cookie. Padrão: gepi_sessao. Aceita os prefixos __Secure- e __Host-,
# que exigem SESSAO_COOKIE_SECURE=true (__Host- também exigirá Path=/ e sem Domain).
SESSAO_COOKIE_NOME=gepi_sessao
# Nome do cookie do Painel Privado da plataforma (Autenticação Global —
# Pacote 2). Precisa ser DIFERENTE de SESSAO_COOKIE_NOME — é essa diferença
# que garante, por construção, que o cookie de um contexto nunca autentica
# no outro. Mesmas regras de formato e prefixo __Secure-/__Host- de
# SESSAO_COOKIE_NOME. Padrão: gepi_sessao_admin.
SESSAO_ADMIN_COOKIE_NOME=gepi_sessao_admin
# true | false. Padrão: true em production, false nos demais ambientes.
# false NÃO é permitido em production.
SESSAO_COOKIE_SECURE=
# strict | lax | none. Padrão: lax. none exige cookie Secure.
SESSAO_COOKIE_SAMESITE=lax
# Expiração absoluta da sessão, em minutos. Padrão 720 (12 h). Mín 5, máx 43200.
SESSAO_EXPIRACAO_MINUTOS=720
# Expiração por inatividade, em minutos. Padrão 30. Mín 1, máx 43200.
# Não pode ser maior que SESSAO_EXPIRACAO_MINUTOS.
SESSAO_INATIVIDADE_MINUTOS=30

# --- Argon2id (hash de senha) ---
# Configuração ESCOLHIDA PELO PROJETO para esta etapa, não a reprodução de
# uma recomendação completa da RFC 9106. Deve ser benchmarkada no ambiente
# de produção antes de ir ao ar. hashLength é fixo em 32 no código e não é
# configurável por variável.
# Memória em KiB. Padrão 65536 (64 MiB). Mín 19456, máx 1048576.
ARGON2_MEMORY_KIB=65536
# Iterações. Padrão 3. Mín 2, máx 20.
ARGON2_TIME_COST=3
# Paralelismo. Padrão 1. Mín 1, máx 8.
ARGON2_PARALLELISM=1

# --- Cooldown de login (ver migration 015) ---
# N falhas dentro da janela ativam bloqueio pela duração. Dois níveis:
# o nível 2 precisa ter mais falhas e janela maior ou igual à do nível 1.
# Falhas: mín 1, máx 100. Janela e duração em minutos: mín 1, máx 1440.
LOGIN_COOLDOWN_NIVEL1_FALHAS=5
LOGIN_COOLDOWN_NIVEL1_JANELA_MINUTOS=15
LOGIN_COOLDOWN_NIVEL1_DURACAO_MINUTOS=15

LOGIN_COOLDOWN_NIVEL2_FALHAS=10
LOGIN_COOLDOWN_NIVEL2_JANELA_MINUTOS=60
LOGIN_COOLDOWN_NIVEL2_DURACAO_MINUTOS=60

# Retenção das linhas de login_tentativas, em dias, aplicada pela rotina de
# manutenção. Padrão 30. Mín 1, máx 365.
LOGIN_TENTATIVAS_RETENCAO_DIAS=30

# ------------------------------------------------------------------
# Segurança HTTP (lida e validada por src/config/http.js)
# ------------------------------------------------------------------

# Número de proxies confiáveis à frente da API. Padrão 0 (nenhum), que faz o
# servidor ignorar X-Forwarded-For e usar o endereço da conexão. Ajuste
# SOMENTE depois de conhecer a topologia real de proxy: um valor maior que o
# número real de saltos permite ao cliente forjar o IP de origem; um valor
# menor agrupa todos os clientes no IP do proxy. Mín 0, máx 10.
TRUST_PROXY_HOPS=0

# Limite de requisições por IP no namespace /api, por janela.
# Camada complementar ao cooldown persistente de login por identidade.
# Limites: mín 1, máx 100000. Janelas em segundos: mín 1, máx 86400.
RATE_LIMIT_GERAL_LIMITE=120
RATE_LIMIT_GERAL_JANELA_SEGUNDOS=60

# Limite mais restritivo para as rotas de autenticação (montado junto das
# rotas de login, no bloco de autenticação).
RATE_LIMIT_AUTH_LIMITE=20
RATE_LIMIT_AUTH_JANELA_SEGUNDOS=60
