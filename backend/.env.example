# Porta em que a API vai escutar
PORT=3000

# Ambiente de execução (development | production | test).
# Em production o cookie de sessão é sempre Secure (ver SESSAO_COOKIE_SECURE).
NODE_ENV=development

# Origem(ns) permitida(s) para CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:5500

# --- Painel Privado da plataforma (Autenticação Global — Pacote 2) ---
# Allowlist SEPARADA de CORS_ORIGIN, exclusiva das rotas /api/plataforma.
# Nunca compartilhar origem com CORS_ORIGIN: um script rodando na origem do
# cliente nunca pode ser uma origem aceita para o Painel Privado, e vice-versa.
# O processo RECUSA A INICIALIZAR se qualquer origem aparecer nas duas
# listas ao mesmo tempo (correção final do Pacote 2, item 2 — isolamento
# de origens verificado na subida, não só documentado). Mesmas regras de
# formato de CORS_ORIGIN (canônica, sem curinga, https em production).
# Padrão fora de production: http://localhost:5501.
PLATAFORMA_CORS_ORIGIN=http://localhost:5501

# Host esperado nas requisições de /api/plataforma (defesa em profundidade).
# OBRIGATÓRIO em production (correção final do Pacote 2, item 3): a ausência
# impede a inicialização do processo, para que a validação de Host nunca
# fique sem efeito em produção por uma variável esquecida. Em development e
# test continua opcional — vazio/ausente: nenhuma validação de Host é
# aplicada (sem subdomínio próprio ainda nesses ambientes). Em produção,
# defina o subdomínio real do Painel Privado (ex.: admin.dominio.com.br).
PLATAFORMA_HOST=

# URLs públicas usadas nos links dos e-mails (redefinição de senha e convites).
# Origem canônica scheme://host[:porta], sem caminho. Não dependem da ordem de
# CORS_ORIGIN: PORTAL_URL_PUBLICA precisa ser uma das origens de CORS_ORIGIN e
# PAINEL_URL_PUBLICA uma das origens de PLATAFORMA_CORS_ORIGIN.
# OBRIGATÓRIAS em production, e com https. Fora de production, quando
# ausentes, valem a primeira origem de CORS_ORIGIN e a primeira de
# PLATAFORMA_CORS_ORIGIN.
PORTAL_URL_PUBLICA=
PAINEL_URL_PUBLICA=

# Conexão com o PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestao_epi
DB_USER=postgres
DB_PASSWORD=postgres

# ------------------------------------------------------------------
# Autenticação (lida e validada por src/config/auth.js na subida do processo)
# Variável vazia conta como ausente e usa o padrão indicado. Se qualquer
# valor for inválido, o processo não sobe e o erro cita só o nome da variável.
# ------------------------------------------------------------------

# Segredo do HMAC-SHA-256 que deriva login_tentativas.chave_cooldown.
# OBRIGATÓRIO, sem padrão e sem fallback em nenhum ambiente.
# Formato: hexadecimal, comprimento par, mínimo 64 caracteres (32 bytes).
# Gere localmente e cole o resultado no seu .env (nunca aqui):
#   openssl rand -hex 32
# O valor gerado NÃO deve ser commitado. Em produção, use um gestor de
# secrets. Trocar o segredo zera, na prática, todos os cooldowns em curso.
LOGIN_COOLDOWN_HMAC_SECRET=

# Cloudflare Turnstile do login do Portal do Cliente (painel da Cloudflare,
# widget do domínio do Portal). A site key é pública; a secret só existe no
# backend e NUNCA vai para o frontend, log ou Git: em produção, gestor de
# secrets. Obrigatórias em production, onde as chaves oficiais de teste da
# Cloudflare são recusadas. Fora de production, deixe as duas vazias para
# usar as chaves de teste (o login aceita qualquer pessoa: só para ambiente
# local), ou preencha as duas. O mesmo par de chaves atende a solicitação
# de recuperação de senha do Portal, com action própria.
TURNSTILE_PORTAL_SITE_KEY=
TURNSTILE_PORTAL_SECRET_KEY=

# Chaves AES-256-GCM que protegem o secret TOTP do MFA do Painel Privado.
# Uma variável MFA_TOTP_KEY_V<n> por versão (64 caracteres hexadecimais =
# 32 bytes); a cifragem usa sempre MFA_TOTP_KEY_CURRENT_VERSION. Sem padrão
# e sem fallback: sem elas, ou com elas malformadas, o processo NÃO SOBE.
# Gere localmente e cole no seu .env (nunca aqui):
#   openssl rand -hex 32
# Nunca reaproveite LOGIN_COOLDOWN_HMAC_SECRET. Em produção, use um gestor de
# secrets e guarde cada versão enquanto algum fator ou backup depender dela.
MFA_TOTP_KEY_CURRENT_VERSION=
MFA_TOTP_KEY_V1=

# --- Cookie de sessão (HttpOnly sempre; a emissão fica no módulo de sessão) ---
# Nome do cookie. Padrão: gepi_sessao. Aceita os prefixos __Secure- e __Host-,
# que exigem SESSAO_COOKIE_SECURE=true (__Host- também exigirá Path=/ e sem Domain).
SESSAO_COOKIE_NOME=gepi_sessao
# Nome do cookie do Painel Privado da plataforma (Autenticação Global —
# Pacote 2). Precisa ser DIFERENTE de SESSAO_COOKIE_NOME — é essa diferença
# que garante, por construção, que o cookie de um contexto nunca autentica
# no outro. Mesmas regras de formato e prefixo __Secure-/__Host- de
# SESSAO_COOKIE_NOME. Padrão: gepi_sessao_admin.
SESSAO_ADMIN_COOKIE_NOME=gepi_sessao_admin
# Nome do cookie da sessão GLOBAL da identidade (Autenticação Global —
# Pacote 4, tabela sessoes_globais). Emitido pelo login global do Portal
# do Cliente; NÃO concede acesso operacional (isso continua sendo o cookie
# empresarial SESSAO_COOKIE_NOME, criado ao selecionar a empresa). Precisa
# ser DIFERENTE de SESSAO_COOKIE_NOME e de SESSAO_ADMIN_COOKIE_NOME — o
# processo recusa iniciar se coincidir. Mesmas regras de formato e prefixo.
# Padrão: gepi_sessao_global.
SESSAO_GLOBAL_COOKIE_NOME=gepi_sessao_global
# Nome do cookie do desafio pré-MFA do Painel Privado (a senha correta abre
# um desafio, não uma sessão). Precisa ser diferente dos três nomes acima; o
# processo recusa iniciar se coincidir. Não aceita o prefixo __Host-, porque
# o cookie usa Path=/api/plataforma/auth. SameSite=Strict fixo; Secure segue
# SESSAO_COOKIE_SECURE. Padrão: gepi_mfa_admin.
SESSAO_MFA_ADMIN_COOKIE_NOME=gepi_mfa_admin
# Prazo do desafio pré-MFA, em minutos. VERIFICACAO (TOTP já cadastrado):
# padrão 5, mín 1, máx 15. LIBERACAO e etapas de cadastro: padrão 15, mín 1,
# máx 60.
MFA_DESAFIO_VERIFICACAO_MINUTOS=5
MFA_DESAFIO_CADASTRO_MINUTOS=15
# Códigos inválidos aceitos por desafio antes de encerrá-lo. Padrão 5, mín 1,
# máx 20.
MFA_DESAFIO_MAX_FALHAS=5
# Validade da liberação de cadastro do MFA emitida pelo CLI, em minutos.
# Padrão 30, mín 5, máx 1440.
MFA_LIBERACAO_MINUTOS=30
# Expiração absoluta da sessão plena do Painel Privado (nasce só depois do
# segundo fator), em minutos. Padrão 480 (8 h), mín 5, máx 1440.
SESSAO_ADMIN_EXPIRACAO_MINUTOS=480
# true | false. Padrão: true em production, false nos demais ambientes.
# false NÃO é permitido em production.
SESSAO_COOKIE_SECURE=
# strict | lax | none. Padrão: lax. none exige cookie Secure.
SESSAO_COOKIE_SAMESITE=lax
# Expiração absoluta da sessão, em minutos. Padrão 720 (12 h). Mín 5, máx 43200.
SESSAO_EXPIRACAO_MINUTOS=720
# Expiração por inatividade, em minutos. Padrão 30. Mín 1, máx 43200.
# Não pode ser maior que SESSAO_EXPIRACAO_MINUTOS.
SESSAO_INATIVIDADE_MINUTOS=30

# --- Argon2id (hash de senha) ---
# Configuração ESCOLHIDA PELO PROJETO para esta etapa, não a reprodução de
# uma recomendação completa da RFC 9106. Deve ser benchmarkada no ambiente
# de produção antes de ir ao ar. hashLength é fixo em 32 no código e não é
# configurável por variável.
# Memória em KiB. Padrão 65536 (64 MiB). Mín 19456, máx 1048576.
ARGON2_MEMORY_KIB=65536
# Iterações. Padrão 3. Mín 2, máx 20.
ARGON2_TIME_COST=3
# Paralelismo. Padrão 1. Mín 1, máx 8.
ARGON2_PARALLELISM=1

# --- Cooldown de login (ver migration 015) ---
# N falhas dentro da janela ativam bloqueio pela duração. Dois níveis:
# o nível 2 precisa ter mais falhas e janela maior ou igual à do nível 1.
# Falhas: mín 1, máx 100. Janela e duração em minutos: mín 1, máx 1440.
LOGIN_COOLDOWN_NIVEL1_FALHAS=5
LOGIN_COOLDOWN_NIVEL1_JANELA_MINUTOS=15
LOGIN_COOLDOWN_NIVEL1_DURACAO_MINUTOS=15

LOGIN_COOLDOWN_NIVEL2_FALHAS=10
LOGIN_COOLDOWN_NIVEL2_JANELA_MINUTOS=60
LOGIN_COOLDOWN_NIVEL2_DURACAO_MINUTOS=60

# Retenção das linhas de login_tentativas, em dias, aplicada pela rotina de
# manutenção. Padrão 30. Mín 1, máx 365.
LOGIN_TENTATIVAS_RETENCAO_DIAS=30

# --- Convite do primeiro MASTER (Pacote 3, migration 033) ---
# Validade do link de convite, em minutos. Padrão 4320 (3 dias). Mín 5,
# máx 43200 (30 dias). "Prazo curto" por desenho: o link é a prova de posse
# do e-mail convidado.
CONVITE_MASTER_EXPIRACAO_MINUTOS=4320

# --- Recuperação de senha (Bloco 11, migrations 061 a 064) ---
# Validade do link de redefinição, em minutos. Padrão 60. Mín 5, máx 240
# (4 horas, o mesmo teto que o banco impõe). O link é de uso único.
RECUPERACAO_SENHA_VALIDADE_MINUTOS=60

# --- Aviso de disponibilidade para entrega (Bloco 12, 12G-6, migration 069) ---
# Minutos de espera depois da ÚLTIMA entrada de estoque que deixou algum item
# de solicitação aprovada disponível para entrega, antes de o e-mail
# consolidado da empresa ficar pronto. Padrão 10. Mín 1, máx 120. Quem envia é
# o processador `npm run alertas:processar`, agendado FORA da API (cron do
# sistema, EventBridge): sem esse agendamento, nenhum aviso automático sai.
ALERTA_ESTOQUE_JANELA_MINUTOS=10

# ------------------------------------------------------------------
# Entrega de e-mail (lida e validada por src/config/email.js)
# ------------------------------------------------------------------

# desativado | arquivo | smtp. Padrão: desativado (a mensagem é descartada).
# arquivo grava a mensagem (TXT e HTML) em EMAIL_ARQUIVO_DIRETORIO e serve
# SOMENTE para desenvolvimento e teste: os arquivos contêm os links.
# smtp entrega pelo provedor SMTP configurado abaixo e é o ÚNICO modo aceito
# em production: com outro modo, ou com SMTP incompleto ou sem TLS, o processo
# NÃO SOBE. A entrega serve os e-mails de recuperação e troca de senha, os
# convites (usuário, primeiro MASTER e reenvio) e os alertas de estoque (12G-6:
# o "Gerar alerta" de falta e o aviso consolidado de disponibilidade).
EMAIL_MODO=desativado
# Obrigatória só no modo arquivo. Caminho absoluto de um diretório FORA do
# repositório; caminho relativo ou dentro do repositório é recusado.
EMAIL_ARQUIVO_DIRETORIO=

# Identidade do remetente. Os padrões abaixo são os aprovados; só troque em
# homologação. O suporte aparece no corpo das mensagens, nunca como remetente
# nem como Reply-To. Endereços em ASCII e minúsculas, sem quebra de linha.
EMAIL_REMETENTE_NOME=SafeWork Engenharia
EMAIL_REMETENTE_ENDERECO=no-reply@safeworkengenharia.com.br
EMAIL_SUPORTE_ENDERECO=suporte@safeworkengenharia.com.br

# Provedor SMTP (modo smtp). SMTP_HOST é obrigatório, só o nome do servidor,
# sem esquema, porta ou caminho. SMTP_SEGURANCA: starttls (padrão, exige TLS
# de verdade, sem rebaixamento) | tls (TLS implícito, em geral porta 465) |
# nenhuma (SEM TLS: só desenvolvimento, recusada em production). O certificado
# do servidor é sempre validado; não existe variável para afrouxar isso.
# Em production SMTP_USUARIO e SMTP_SENHA são obrigatórios. NUNCA coloque o
# valor real aqui: a senha vem do ambiente ou do serviço de secrets.
SMTP_HOST=
SMTP_PORTA=587
SMTP_SEGURANCA=starttls
SMTP_USUARIO=
SMTP_SENHA=
# Limite de tempo de conexão e de cada etapa do SMTP, em milissegundos.
# Padrão 10000. Mín 1000, máx 30000.
SMTP_TIMEOUT_MS=10000

# ------------------------------------------------------------------
# Segurança HTTP (lida e validada por src/config/http.js)
# ------------------------------------------------------------------

# Número de proxies confiáveis à frente da API. Padrão 0 (nenhum), que faz o
# servidor ignorar X-Forwarded-For e usar o endereço da conexão. Ajuste
# SOMENTE depois de conhecer a topologia real de proxy: um valor maior que o
# número real de saltos permite ao cliente forjar o IP de origem; um valor
# menor agrupa todos os clientes no IP do proxy. Mín 0, máx 10.
# O endereço resolvido assim é também o comparado com os IPs permitidos do
# usuário (Gestão de Usuários → Novo → Usuário, migration 077): com a
# topologia errada, a restrição por IP não protege ou bloqueia todo mundo.
TRUST_PROXY_HOPS=0

# Limite de requisições por IP no namespace /api, por janela.
# Camada complementar ao cooldown persistente de login por identidade.
# Limites: mín 1, máx 100000. Janelas em segundos: mín 1, máx 86400.
RATE_LIMIT_GERAL_LIMITE=120
RATE_LIMIT_GERAL_JANELA_SEGUNDOS=60

# Limite mais restritivo para as rotas de autenticação (montado junto das
# rotas de login, no bloco de autenticação).
RATE_LIMIT_AUTH_LIMITE=20
RATE_LIMIT_AUTH_JANELA_SEGUNDOS=60
