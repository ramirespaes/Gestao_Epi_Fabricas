{
  "name": "gestao-epi-api",
  "version": "1.0.0",
  "description": "API backend do sistema de Gestão de EPIs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --require ./test/setup.js --test \"test/**/*.test.js\"",
    "test:cobertura": "node --require ./test/setup.js --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-exclude=\"src/server.js\" \"test/**/*.test.js\"",
    "pretest:ci": "node -e \"require('node:fs').mkdirSync('coverage', { recursive: true })\"",
    "test:ci": "node --require ./test/setup.js --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-exclude=\"src/server.js\" --test-coverage-lines=75 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"test/**/*.test.js\"",
    "test:integracao": "node --require dotenv/config --require ./test/setup.js --test \"test/integracao/**/*.integration.js\""
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "argon2": "^0.45.1",
    "cookie": "^0.7.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
